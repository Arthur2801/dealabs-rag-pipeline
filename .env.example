# Required to query or index deals in MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/

# Required for the generated answer in the Streamlit app
GROQ_API_KEY=<groq-api-key>

# Required only when extracting new deals via scripts/extract_deals.py
DEALABS_CLIENT_KEY=<dealabs-client-key>
DEALABS_CLIENT_SECRET=<dealabs-client-secret>
